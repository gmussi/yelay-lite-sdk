{
	"compilerOptions": {
		"target": "ES2021",
		"module": "commonjs",
		"declaration": true,
		"strictNullChecks": true,
		"esModuleInterop": true,
		"downlevelIteration": true,
		"outDir": "./build",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"types": ["jest", "node"],
		// Add baseUrl and paths for chain barrel alias
		"baseUrl": ".",
		"paths": {
			"@chain": ["src/adapters/providers/chain.ts"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "**/__tests__/*", "tests/**/*"]
}
